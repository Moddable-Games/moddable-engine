{
  "name": "@moddable/engine",
  "private": true,
  "description": "Micro-kernel master engine for all Moddable Games titles",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/topologies/*",
    "packages/plugins/*"
  ],
  "exports": {
    "./core": "./packages/core/index.js",
    "./plugins": "./packages/plugins/index.js",
    "./plugins/*": "./packages/plugins/*/index.js",
    "./topologies": "./packages/topologies/index.js",
    "./topologies/*": "./packages/topologies/*/index.js",
    "./component-dice": "./packages/component-dice/index.js",
    "./component-deck": "./packages/component-deck/index.js",
    "./hex-generators": "./packages/hex-generators/index.js",
    "./rpg": "./packages/rpg/index.js",
    "./ai": "./packages/ai/index.js",
    "./render": "./packages/render/index.js",
    "./surface": "./packages/surface/index.js",
    "./schema": "./packages/schema/index.js",
    "./game": "./packages/game/index.js",
    "./rule": "./packages/rule/index.js",
    "./piece-behaviour": "./packages/piece-behaviour/index.js",
    "./board-theme": "./packages/board-theme/index.js",
    "./piece-theme": "./packages/piece-theme/index.js",
    "./play": "./packages/play/index.js",
    "./chess-sdk": "./packages/plugins/chess/src/sdk.js",
    "./hex-sdk": "./packages/hex-generators/src/sdk.js",
    "./go-sdk": "./packages/plugins/go/index.js",
    "./draughts-sdk": "./packages/plugins/draughts/index.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "build": "npm run build --workspaces",
    "lint": "eslint packages/*/src/**/*.js",
    "variant-report": "node --experimental-vm-modules scripts/variant-report.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moddable-Games/moddable-engine.git"
  },
  "license": "MIT"
}
