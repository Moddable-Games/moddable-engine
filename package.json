{
  "name": "@moddable/engine",
  "description": "Micro-kernel master engine for all Moddable Games titles",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/topologies/*",
    "packages/plugins/*"
  ],
  "exports": {
    "./core": "./packages/core/index.js",
    "./plugins": "./packages/plugins/index.js",
    "./plugins/*": "./packages/plugins/*/index.js",
    "./topologies": "./packages/topologies/index.js",
    "./topologies/*": "./packages/topologies/*/index.js",
    "./component-dice": "./packages/component-dice/index.js",
    "./component-deck": "./packages/component-deck/index.js",
    "./hex-generators": "./packages/hex-generators/index.js",
    "./rpg": "./packages/rpg/index.js",
    "./ai": "./packages/ai/index.js",
    "./render": "./packages/render/index.js",
    "./schema": "./packages/schema/index.js",
    "./game": "./packages/game/index.js",
    "./rule": "./packages/rule/index.js",
    "./piece-behaviour": "./packages/piece-behaviour/index.js",
    "./play": "./packages/play/index.js",
    "./hex-sdk": "./packages/hex-generators/src/sdk.js",
    "./go-sdk": "./packages/plugins/go/index.js",
    "./draughts-sdk": "./packages/plugins/draughts/index.js"
  },
  "scripts": {
    "test": "MODDABLE_PUBLISH_TEST_COUNTS=1 node --experimental-vm-modules node_modules/.bin/jest",
    "test:fast": "node scripts/run-tests.mjs fast",
    "test:slow": "node scripts/run-tests.mjs slow",
    "test:perf": "node scripts/run-tests.mjs perf",
    "test:related": "node scripts/run-tests.mjs related",
    "test:all": "node scripts/run-tests.mjs all",
    "build": "npm run build --workspaces",
    "variant-report": "node --experimental-vm-modules scripts/variant-report.mjs",
    "build:discovery": "node scripts/build-discovery.mjs",
    "check:discovery": "node scripts/build-discovery.mjs --check",
    "build:puzzles": "node scripts/normalise-puzzles.mjs",
    "check:puzzles": "node scripts/normalise-puzzles.mjs --check",
    "gen:manifest": "MODDABLE_RULES_DIR=../moddable-rules/games node scripts/gen-playability-manifest.mjs",
    "gen:family-defaults": "MODDABLE_RULES_DIR=../moddable-rules/games node scripts/gen-family-defaults.mjs",
    "gen:puzzles": "MODDABLE_RULES_DIR=../moddable-rules/games node scripts/generate-puzzles.mjs",
    "boards:export": "node scripts/export-boards.mjs --export",
    "boards:snapshot": "node scripts/snapshot-boards.mjs --capture",
    "boards:diff": "node scripts/snapshot-boards.mjs --diff",
    "boards:index": "node scripts/build-board-index.mjs",
    "boards:compare": "node scripts/compare-engine.mjs",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:purity": "node scripts/check-purity.mjs",
    "check:all": "npm run check:duplication && npm run check:purity && npm run check:discovery && npm run check:puzzles",
    "audit:frontmatter": "MODDABLE_RULES_DIR=../moddable-rules/games node scripts/audit-frontmatter-gap.mjs",
    "audit:resolvers": "node scripts/compare-resolvers.mjs",
    "audit:playability": "MODDABLE_RULES_DIR=../moddable-rules/games node scripts/playability-matrix.mjs",
    "bench:ai": "node scripts/bench-ai.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moddable-Games/moddable-engine.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.62.1",
    "jest": "^29.7.0",
    "knip": "^6.31.0"
  }
}
